#!/bin/bash
#SBATCH --job-name=mri-pipeline-infer
#SBATCH --output=slurm-%j.out
#SBATCH --error=slurm-%j.err
#SBATCH --time=08:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --gres=gpu:1
#SBATCH --partition=gpus
#SBATCH --account=ebrains-0000006

# ============================================================================
# HPC full inference launcher for existing segmentation and classification checkpoints
# ============================================================================
# Works in both modes:
#   1) Direct run: bash scripts/new/pipeline-inference [args...]
#   2) SLURM run:  sbatch scripts/new/pipeline-inference [args...]
#
# Examples:
#   bash scripts/new/pipeline-inference \
#     --seg-checkpoint checkpoints/seg/run/run_best.pt \
#     --cls-checkpoint checkpoints/cls/run/run_best.pt \
#     --dry-run
#   sbatch scripts/new/pipeline-inference \
#     --seg-config checkpoints/autopilot/seg-run/resolved_config.yaml \
#     --seg-checkpoint checkpoints/seg/run/run_best.pt \
#     --cls-config checkpoints/cls/run/resolved_config.yaml \
#     --cls-checkpoint checkpoints/cls/run/run_best.pt
# ============================================================================

set -euo pipefail

if [[ -z "${BASH_VERSION:-}" ]]; then
    exec bash "$0" "$@"
fi

is_project_dir() {
    local candidate="${1:-}"
    [[ -n "${candidate}" && -d "${candidate}" && -f "${candidate}/mri/cli/pipeline_infer.py" && -f "${candidate}/scripts/new/pipeline-inference" ]]
}

resolve_slurm_command_path() {
    local job_line command_path

    if [[ -z "${SLURM_JOB_ID:-}" ]] || ! command -v scontrol &> /dev/null; then
        return 1
    fi

    job_line="$(scontrol show job -o "${SLURM_JOB_ID}" 2> /dev/null || true)"
    if [[ -z "${job_line}" ]]; then
        return 1
    fi

    command_path="$(
        awk '
            {
                for (i = 1; i <= NF; i++) {
                    if ($i ~ /^Command=/) {
                        sub(/^Command=/, "", $i)
                        print $i
                        exit
                    }
                }
            }
        ' <<< "${job_line}"
    )"

    if [[ -z "${command_path}" ]]; then
        return 1
    fi

    if [[ "${command_path}" != /* && -n "${SLURM_SUBMIT_DIR:-}" ]]; then
        command_path="${SLURM_SUBMIT_DIR}/${command_path}"
    fi

    echo "${command_path}"
}

resolve_project_dir() {
    local candidate script_dir command_path

    if [[ -n "${MRI_PIPELINE_INFER_PROJECT_DIR:-}" ]]; then
        candidate="$(cd "${MRI_PIPELINE_INFER_PROJECT_DIR}" 2> /dev/null && pwd || true)"
        if is_project_dir "${candidate}"; then
            echo "${candidate}"
            return 0
        fi
        echo "ERROR: MRI_PIPELINE_INFER_PROJECT_DIR is not a valid project root: ${MRI_PIPELINE_INFER_PROJECT_DIR}" >&2
        return 1
    fi

    if [[ -n "${SLURM_JOB_ID:-}" ]]; then
        command_path="$(resolve_slurm_command_path || true)"
        if [[ -n "${command_path}" ]]; then
            candidate="$(cd "$(dirname "${command_path}")/../.." 2> /dev/null && pwd || true)"
            if is_project_dir "${candidate}"; then
                echo "${candidate}"
                return 0
            fi
        fi

        if is_project_dir "${SLURM_SUBMIT_DIR:-}"; then
            candidate="$(cd "${SLURM_SUBMIT_DIR}" && pwd)"
            echo "${candidate}"
            return 0
        fi
    fi

    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    candidate="$(cd "${script_dir}/../.." && pwd)"
    if is_project_dir "${candidate}"; then
        echo "${candidate}"
        return 0
    fi

    echo "ERROR: Could not resolve the project directory for scripts/new/pipeline-inference." >&2
    echo "Set MRI_PIPELINE_INFER_PROJECT_DIR to the repository root if you are launching via SLURM from outside the repo." >&2
    return 1
}

require_option_value() {
    local option_name="$1"
    local option_value="${2:-}"

    if [[ -z "${option_value}" || "${option_value}" == --* ]]; then
        echo "ERROR: ${option_name} requires a value."
        exit 1
    fi
}

resolve_container_runtime() {
    if command -v singularity &> /dev/null; then
        echo "singularity"
        return 0
    fi
    if command -v apptainer &> /dev/null; then
        echo "apptainer"
        return 0
    fi
    return 1
}

resolve_container_image() {
    local project_parent image_dir candidate

    project_parent="$(dirname "${PROJECT_DIR}")"
    image_dir="${project_parent}/singularity_images"

    for candidate in \
        "${MRI_PIPELINE_INFER_CONTAINER_IMAGE:-}" \
        "${MRI_INFER_CONTAINER_IMAGE:-}" \
        "${MRI_TRAIN_CONTAINER_IMAGE:-}" \
        "${image_dir}/mri-train3.sif" \
        "${image_dir}/mri-train2.sif" \
        "${image_dir}/mri-train.sif"
    do
        if [[ -n "${candidate}" && -f "${candidate}" ]]; then
            echo "${candidate}"
            return 0
        fi
    done

    return 1
}

PROJECT_DIR="$(resolve_project_dir)"

cd "${PROJECT_DIR}" || {
    echo "ERROR: Cannot change to project directory: ${PROJECT_DIR}"
    exit 1
}

if [[ -f "${PROJECT_DIR}/.env" ]]; then
    set -a
    source "${PROJECT_DIR}/.env"
    set +a
fi

MRI_PIPELINE_INFER_USE_CONTAINER="${MRI_PIPELINE_INFER_USE_CONTAINER:-${MRI_INFER_USE_CONTAINER:-${MRI_TRAIN_USE_CONTAINER:-auto}}}"
if [[ -z "${MRI_PIPELINE_INFER_IN_CONTAINER:-}" && "${MRI_PIPELINE_INFER_USE_CONTAINER}" != "never" ]]; then
    CONTAINER_RUNTIME="$(resolve_container_runtime || true)"
    CONTAINER_IMAGE="$(resolve_container_image || true)"

    if [[ -n "${CONTAINER_RUNTIME}" && -n "${CONTAINER_IMAGE}" ]]; then
        BIND_ROOT="${MRI_PIPELINE_INFER_BIND_ROOT:-${MRI_INFER_BIND_ROOT:-${MRI_TRAIN_BIND_ROOT:-$(dirname "${PROJECT_DIR}")}}}"
        export MRI_PIPELINE_INFER_IN_CONTAINER=1

        echo "============================================================================"
        echo "MRI Pipeline Inference (Singularity HPC)"
        echo "Project:    ${PROJECT_DIR}"
        echo "Runtime:    ${CONTAINER_RUNTIME}"
        echo "Image:      ${CONTAINER_IMAGE}"
        echo "Bind root:  ${BIND_ROOT}"
        echo "SLURM Job:  ${SLURM_JOB_ID:-local}"
        echo "============================================================================"

        exec "${CONTAINER_RUNTIME}" exec \
            --nv \
            -B "${BIND_ROOT}:${BIND_ROOT}" \
            --pwd "${PROJECT_DIR}" \
            "${CONTAINER_IMAGE}" \
            bash "${PROJECT_DIR}/scripts/new/pipeline-inference" "$@"
    fi

    if [[ "${MRI_PIPELINE_INFER_USE_CONTAINER}" == "always" ]]; then
        echo "ERROR: Container mode requested but no Singularity/Apptainer runtime or image was found."
        echo "Set MRI_PIPELINE_INFER_CONTAINER_IMAGE or place mri-train3.sif under $(dirname "${PROJECT_DIR}")/singularity_images."
        exit 1
    fi
fi

PYTHON_BIN="${PYTHON_BIN:-python}"
DATA_DIR="${DATA_DIR:-${PROJECT_DIR}/data}"
CHECKPOINT_DIR="${CHECKPOINT_DIR:-${PROJECT_DIR}/checkpoints}"
PIPELINE_OUTPUT_ROOT="${PIPELINE_OUTPUT_ROOT:-${PROJECT_DIR}/experiments/pipeline_inference}"
WANDB_DIR="${WANDB_DIR:-${PROJECT_DIR}/wandb}"
WANDB_MODE="${WANDB_MODE:-offline}"
PRETRAINED_CACHE_DIR="${PRETRAINED_CACHE_DIR:-${PROJECT_DIR}/pretrained_model}"
MPLCONFIGDIR="${MPLCONFIGDIR:-${PROJECT_DIR}/.cache/matplotlib}"

mkdir -p "${CHECKPOINT_DIR}" "${PIPELINE_OUTPUT_ROOT}" "${WANDB_DIR}" "${PROJECT_DIR}/.aim" "${PRETRAINED_CACHE_DIR}/torch" "${PRETRAINED_CACHE_DIR}/huggingface" "${MPLCONFIGDIR}"

export DATA_DIR
export CHECKPOINT_DIR
export WANDB_DIR
export WANDB_MODE
export TORCH_HOME="${TORCH_HOME:-${PRETRAINED_CACHE_DIR}/torch}"
export HF_HOME="${HF_HOME:-${PRETRAINED_CACHE_DIR}/huggingface}"
export MPLCONFIGDIR
export PYTHONPATH="${PROJECT_DIR}:${PYTHONPATH:-}"

HAS_OUTPUT_ROOT=0
DRY_RUN=0
PASS_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --output-root|--output_root)
            require_option_value "$1" "${2:-}"
            HAS_OUTPUT_ROOT=1
            PASS_ARGS+=("--output-root" "$2")
            shift 2
            ;;
        --output-root=*|--output_root=*)
            require_option_value "${1%%=*}" "${1#*=}"
            HAS_OUTPUT_ROOT=1
            PASS_ARGS+=("$1")
            shift
            ;;
        --dry-run)
            DRY_RUN=1
            PASS_ARGS+=("$1")
            shift
            ;;
        *)
            PASS_ARGS+=("$1")
            shift
            ;;
    esac
done

if [[ ${HAS_OUTPUT_ROOT} -eq 0 ]]; then
    PASS_ARGS+=("--output-root" "${PIPELINE_OUTPUT_ROOT}")
fi

CMD=("${PYTHON_BIN}" "mri/cli/pipeline_infer.py" "${PASS_ARGS[@]}")

echo "============================================================================"
echo "MRI Pipeline Inference (Native HPC)"
echo "Project:     ${PROJECT_DIR}"
echo "Python:      ${PYTHON_BIN}"
echo "Mode:        mri/cli"
echo "Data dir:    ${DATA_DIR}"
echo "Checkpoints: ${CHECKPOINT_DIR}"
echo "Output root: ${PIPELINE_OUTPUT_ROOT}"
echo "MPL config:  ${MPLCONFIGDIR}"
echo "SLURM Job:   ${SLURM_JOB_ID:-local}"
echo "Command:     ${CMD[*]}"
echo "============================================================================"

if command -v nvidia-smi &> /dev/null; then
    nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv || true
fi

if [[ ${DRY_RUN} -eq 1 ]]; then
    echo "DRY RUN: command not executed."
    exit 0
fi

if command -v srun &> /dev/null && [[ -n "${SLURM_JOB_ID:-}" ]]; then
    srun "${CMD[@]}"
else
    "${CMD[@]}"
fi
